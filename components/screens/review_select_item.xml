<?xml version="1.0" encoding="utf-8" ?>
<component name="ReviewSelectItem" extends="Group">
  <interface>
    <field id = "itemContent" type = "node" onChange = "showcontent"/>
    <field id = "focusPercent" type = "float" onChange = "showcontent"/> 
    <field id = "rowFocusPercent" type = "float" onChange = "showcontent"/>
    <field id = "videouri" type = "uri" />
	</interface>
	<script type="text/brightscript" uri="pkg:/components/screens/review_select_item.brs" />
	<children>
		<!-- Item description -->
    <Poster
      id="stars"
      width="800"
      height="400"
      translation="[100,400]" />  
    <Label
      id="title"
      font="font:LargeBoldSystemFont"
      color="0xFFFFFF"
      text="Click to watch video!"
      translation="[1200,900]" />
    <Label
      id="description"
      font="font:MediumSystemFont"
      color="0xFFFFFF"
			wrap="true"
			width="800"
      text=""
      translation="[150,700]" />
    <Poster 
      id="thumbnail"
      width="500"
      height="280"
      translation="[750,0]" />  
	</children>
</component>